{
  "manifest_version": 3,
  "name": "BandeJA Downloader",
  "version": "0.1.0",
  "description": "Automatiza descargas ZIP desde BandeJA",
  "permissions": [
    "downloads",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://extranet.chie.junta-andalucia.es/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://extranet.chie.junta-andalucia.es/bandeja/*"],
      "js": ["bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://extranet.chie.junta-andalucia.es/bandeja/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "BandeJA Downloader"
  }
}
